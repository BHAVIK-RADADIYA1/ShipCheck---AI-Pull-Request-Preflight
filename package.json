{
  "name": "shipcheck",
  "version": "0.1.0",
  "description": "Open-source preflight review for code changes: is this change ready for review?",
  "license": "MIT",
  "type": "module",
  "bin": {
    "shipcheck": "./dist/src/cli.js"
  },
  "main": "./dist/src/index.js",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node scripts/run-tests.mjs",
    "review": "node dist/src/cli.js review --base main",
    "prepack": "npm run build"
  },
  "keywords": [
    "code-review",
    "pull-request",
    "preflight",
    "cli",
    "open-source"
  ],
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3"
  }
}