# ShipCheck reads these from the process environment. It does not load .env
# automatically: export them in your shell or use your own environment loader.
# Never commit a real .env file or a real API key.

# Optional AI review. All three are required to enable it.
# ShipCheck has no default endpoint or model; use any OpenAI-compatible API,
# including a locally served open-weight model.
SHIPCHECK_AI_BASE_URL=
SHIPCHECK_AI_MODEL=
SHIPCHECK_AI_API_KEY=
